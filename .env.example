# Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Fal.ai API Key (from https://fal.ai/dashboard/keys)
FAL_KEY=your_fal_key_here

# Replicate API Token (Backup/Alternative Video Generation Provider)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Optional: Default TTS Voice (e.g. en-US-ChristopherNeural, en-US-GuyNeural, en-US-JennyNeural, en-US-AndrewNeural)
TTS_VOICE=en-US-ChristopherNeural

# Optional: YouTube upload privacy status (public, unlisted, private)
YOUTUBE_PRIVACY_STATUS=public
